rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny for unlisted documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Maintenance Tasks collection
    match /maintenanceTasks/{taskId} {
      allow read, write: if isValidId(taskId);
    }

    // Trains timetable collection
    match /trains/{trainId} {
      allow read, write: if isValidId(trainId);
    }

    // Block Windows collection
    match /blockWindows/{blockId} {
      allow read, write: if isValidId(blockId);
    }

    // Block Plans collection
    match /blockPlans/{planId} {
      allow read, write: if isValidId(planId);
    }

    // Railway Assets collection
    match /assets/{assetId} {
      allow read, write: if isValidId(assetId);
    }

    // AI Recommendations collection
    match /aiRecommendations/{recommendationId} {
      allow read, write: if isValidId(recommendationId);
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
